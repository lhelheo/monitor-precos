{
  "name": "monitor-precos",
  "version": "0.1.0",
  "description": "Monitor 24/7 de preços (Kabum, Amazon, Magalu, Mercado Livre, Shopee) com histórico, cupons e alertas no Telegram",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "check": "node src/cli/check.ts",
    "telegram:login": "node src/cli/telegram-login.ts",
    "telegram:chats": "node src/cli/telegram-chats.ts",
    "test": "node --test test/core.test.js test/db.test.js test/imports.test.js",
    "dev": "node --watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@fastify/basic-auth": "^6.3.1",
    "@fastify/static": "^10.1.11",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "grammy": "^1.46.0",
    "playwright": "^1.65.1",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
