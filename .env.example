# ---- Telegram (bot de notificações e comandos) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Leitor de canais de promoção (opcional) ----
# my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# gerada com: npm run telegram:login
TELEGRAM_SESSION=
# separados por vírgula, ex.: canal1,canal2
TELEGRAM_PROMO_CHANNELS=

# ---- Mercado Livre (API oficial; crie um app em developers.mercadolivre.com.br) ----
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# ---- Claude (extração de cupons de mensagens; opcional) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Painel web ----
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_USER=admin
WEB_PASSWORD=troque-esta-senha
# URL pública (ex.: https://precos.seudominio.com), usada nos links do Telegram
WEB_PUBLIC_URL=

# ---- Agendador ----
CHECK_INTERVAL_MIN=10
PER_STORE_GAP_SEC=20
CHECK_CONCURRENCY=1

# ---- Navegador (Playwright) ----
BROWSER_ENABLED=true
BROWSER_IDLE_CLOSE_SEC=0

# ---- Alertas ----
ALERT_BELOW_MEDIAN_PCT=10
ALERT_MEDIAN_WINDOW_DAYS=30
ALERT_MIN_HISTORY_DAYS=3
ALERT_COOLDOWN_HOURS=12
ALERT_INCLUDE_PROBABLE_COUPONS=true

# ---- Seu perfil ----
USER_FIRST_PURCHASE=false
USER_AMAZON_PRIME=false

LOG_LEVEL=info
